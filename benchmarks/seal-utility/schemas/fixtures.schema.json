{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offsend.local/schemas/seal-utility-fixtures.json",
  "title": "Seal utility fixture generators",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["kind"],
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "url_password",
          "email",
          "aws_access_key",
          "github_pat",
          "openai_api_key",
          "stripe_secret",
          "slack_bot",
          "jwt",
          "bearer"
        ]
      }
    }
  }
}
